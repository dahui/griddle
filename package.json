{
  "name": "griddle",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build": "bun run build:shared && bun run build:desktop",
    "build:shared": "bun run --cwd packages/shared build",
    "typecheck": "tsc --build --force",
    "test": "bun test",
    "app": "cd crates/griddle-app && tauri dev",
    "app:build": "cd crates/griddle-app && tauri build",
    "app:release": "bun run build:desktop && cargo build --release -p griddle-app"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "bun-types": "^1.1.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
