{
  "name": "sgdb-artwork-manager",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:bpm": "bun run --cwd apps/bpm build",
    "build": "bun run build:shared && bun run build:desktop && bun run build:bpm",
    "build:shared": "bun run --cwd packages/shared build",
    "typecheck": "tsc --build --force",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
